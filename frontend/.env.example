# Frontend build-time settings. Everything here is PUBLIC (bundled into the browser):
# never put SerpApi, LLM, Jev or other keys in a VITE_ variable.
#
# Where the browser calls the API. Leave unset when the frontend and API share one origin
# (dev: the Vite proxy forwards /v1 and /health to http://localhost:8000).
# VITE_API_BASE_URL=https://proofgate-api.example.internal
