# ProofGate — env template. Copy to .env and fill in.
# Secrets stay server-side. Never expose to frontend.
# SERPAPI_API_KEY and LLM_API_KEY are REQUIRED — without them the
# pipeline refuses to run instead of fabricating results.

# SerpApi (live discovery; engine auto-picked per request)
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_hotels
# SERPAPI_ENGINE is a default; pipeline picks engine per action (hotels/shopping/flights/google).

# LLM (semantic matching/ranking + requirement parsing + Jev-via-LLM adjudication)
# OpenAI-compatible chat-completions endpoint. Works with OpenAI, DeepSeek, OpenRouter, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60

# Jev (requirement-level adjudication) — official TypeSafe Jev.
# Get a key at https://console.typesafe.ai/keys. Endpoint + model already
# default to the official API; just set JEV_API_KEY.
# If unset, ProofGate uses the LLM-backed Jev adjudicator (needs LLM_API_KEY).
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_SATISFIED_AT=0.75
JEV_CONTRADICTED_BELOW=0.25
JEV_TIMEOUT_S=60

# ProofGate
PROOFGATE_DB_PATH=./proofgate.db

# Demo access (see DEPLOYMENT.md). Leave PROOFGATE_DEMO_PASSWORD empty for local development
# (no sign-in). In production (PROOFGATE_ENV=production) both values are REQUIRED or the API
# stays closed: password 12+ characters, session secret 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PROOFGATE_ENV=production
PROOFGATE_DEMO_PASSWORD=
PROOFGATE_SESSION_SECRET=
# PROOFGATE_SESSION_TTL_MIN=120       # token lifetime in minutes
# PROOFGATE_CLIENT_IP_HEADER=True-Client-IP   # behind Render: visitor IP for per-IP login throttling
# Spend protection (in memory: resets on restart; not a permanent cost cap)
# PROOFGATE_REQUESTS_PER_MIN=120      # any /v1 request, per session
# PROOFGATE_SPEND_PER_SESSION=10      # live searches/verifications per session per window
# PROOFGATE_SPEND_GLOBAL_MAX=60       # live searches/verifications for the whole server per window
# PROOFGATE_SPEND_WINDOW_MIN=60

# Server (see DEPLOYMENT.md). Defaults are safe for local development.
# PROOFGATE_HOST=127.0.0.1          # bind address; 0.0.0.0 exposes the API to your network
# PROOFGATE_PORT=8000               # or PORT (used by many hosts)
# PROOFGATE_RELOAD=1                # set 0 when deploying
# PROOFGATE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
